<?xml version="1.0" encoding="UTF-8"?>

<?import com.stockly.ui.Icon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane fx:id="root" styleClass="app-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stockly.controller.MainController">
    <HBox>
        <!-- ============================ SIDEBAR ============================ -->
        <VBox styleClass="sidebar" minWidth="248" prefWidth="248" maxWidth="248">
            <fx:define>
                <ToggleGroup fx:id="navGroup"/>
            </fx:define>

            <HBox styleClass="brand" alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="brand-mark">
                    <Icon name="box" size="22" styleClass="icon-white"/>
                </StackPane>
                <VBox spacing="1" HBox.hgrow="ALWAYS">
                    <Label text="Stockly" styleClass="brand-name"/>
                    <Label text="Smart Inventory. Simplified Management." styleClass="brand-caption" wrapText="true"/>
                </VBox>
            </HBox>

            <Label text="MENU" styleClass="sidebar-section"/>
            <ToggleButton fx:id="navDashboard" text="Dashboard" styleClass="nav-item" toggleGroup="$navGroup" selected="true" maxWidth="Infinity">
                <graphic><Icon name="dashboard" size="18"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navInventory" text="Inventory" styleClass="nav-item" toggleGroup="$navGroup" maxWidth="Infinity">
                <graphic><Icon name="inventory" size="18"/></graphic>
            </ToggleButton>
            <ToggleButton fx:id="navReports" text="Reports" styleClass="nav-item" toggleGroup="$navGroup" maxWidth="Infinity">
                <graphic><Icon name="reports" size="18"/></graphic>
            </ToggleButton>

            <Region VBox.vgrow="ALWAYS"/>

            <HBox styleClass="sidebar-footer" alignment="CENTER_LEFT" spacing="12">
                <StackPane styleClass="avatar">
                    <Label text="SM" styleClass="avatar-text"/>
                </StackPane>
                <VBox spacing="1">
                    <Label text="Store Manager" styleClass="profile-name"/>
                    <Label fx:id="versionLabel" text="Version" styleClass="profile-caption"/>
                </VBox>
            </HBox>
        </VBox>

        <!-- ============================ MAIN AREA ============================ -->
        <VBox HBox.hgrow="ALWAYS">
            <HBox styleClass="topbar" alignment="CENTER_LEFT" spacing="16" fillHeight="false">
                <VBox spacing="3" HBox.hgrow="ALWAYS">
                    <Label fx:id="dateLabel" styleClass="date-label"/>
                    <Label fx:id="pageTitle" text="Dashboard" styleClass="page-title"/>
                    <Label fx:id="pageSubtitle" styleClass="page-subtitle"/>
                </VBox>

                <HBox fx:id="searchBox" styleClass="search-box" alignment="CENTER_LEFT" spacing="8" minWidth="280" prefWidth="300">
                    <Icon name="search" size="16" styleClass="icon-muted"/>
                    <TextField fx:id="searchField" promptText="Search products by name…" HBox.hgrow="ALWAYS"/>
                </HBox>

                <Button text="Add Product" styleClass="btn,btn-primary" onAction="#handleAddProduct">
                    <graphic><Icon name="plus" size="16" styleClass="icon-white"/></graphic>
                </Button>
            </HBox>

            <StackPane fx:id="contentHost" VBox.vgrow="ALWAYS"/>
        </VBox>
    </HBox>

    <!-- Toast notifications float above everything else, bottom right. -->
    <VBox fx:id="toastLayer" styleClass="toast-layer" spacing="10" alignment="BOTTOM_RIGHT" mouseTransparent="true" pickOnBounds="false" maxWidth="-Infinity" maxHeight="-Infinity" StackPane.alignment="BOTTOM_RIGHT"/>
</StackPane>
