<?xml version="1.0" encoding="UTF-8"?>

<?import com.stockly.ui.Icon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<StackPane styleClass="dialog-root" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stockly.controller.ProductDialogController">
    <VBox styleClass="dialog-card" minWidth="460" prefWidth="460" maxWidth="460" maxHeight="-Infinity">

        <HBox styleClass="dialog-header" alignment="TOP_LEFT" spacing="14">
            <StackPane styleClass="icon-bubble,bubble-emerald"><Icon name="inventory" size="20" styleClass="icon-emerald"/></StackPane>
            <VBox spacing="3" HBox.hgrow="ALWAYS">
                <Label fx:id="titleLabel" styleClass="dialog-title"/>
                <Label fx:id="subtitleLabel" styleClass="dialog-subtitle" wrapText="true"/>
            </VBox>
            <Button styleClass="icon-btn,icon-btn-neutral" onAction="#handleCancel" focusTraversable="false">
                <graphic><Icon name="close" size="16"/></graphic>
            </Button>
        </HBox>

        <VBox styleClass="dialog-body" spacing="18">
            <VBox spacing="6">
                <Label text="Product Name" styleClass="field-label"/>
                <TextField fx:id="nameField" promptText="e.g. Wireless Mouse"/>
                <Label fx:id="nameError" styleClass="field-error" visible="false" managed="false" wrapText="true"/>
            </VBox>

            <VBox spacing="6">
                <Label text="Quantity" styleClass="field-label"/>
                <TextField fx:id="quantityField" promptText="e.g. 25"/>
                <Label fx:id="quantityError" styleClass="field-error" visible="false" managed="false" wrapText="true"/>
            </VBox>

            <HBox styleClass="status-preview" alignment="CENTER_LEFT" spacing="10">
                <VBox spacing="1" HBox.hgrow="ALWAYS">
                    <Label text="Stock status" styleClass="preview-title"/>
                    <Label text="Set automatically from the quantity" styleClass="preview-caption"/>
                </VBox>
                <HBox fx:id="previewHolder" alignment="CENTER_RIGHT"/>
            </HBox>

            <Label fx:id="formError" styleClass="form-error" visible="false" managed="false" wrapText="true" maxWidth="Infinity"/>
        </VBox>

        <HBox styleClass="dialog-footer" alignment="CENTER_RIGHT" spacing="10">
            <Button text="Cancel" styleClass="btn,btn-secondary" cancelButton="true" onAction="#handleCancel"/>
            <Button fx:id="saveButton" text="Save Product" styleClass="btn,btn-primary" defaultButton="true" onAction="#handleSave"/>
        </HBox>
    </VBox>
</StackPane>
