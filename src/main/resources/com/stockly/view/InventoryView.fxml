<?xml version="1.0" encoding="UTF-8"?>

<?import com.stockly.ui.Icon?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>

<VBox styleClass="page" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.stockly.controller.InventoryController">
    <fx:define>
        <ToggleGroup fx:id="filterGroup"/>
    </fx:define>

    <VBox fx:id="tableCard" styleClass="card,table-card" VBox.vgrow="ALWAYS" maxWidth="Infinity">
        <HBox styleClass="table-toolbar" alignment="CENTER_LEFT" spacing="8">
            <ToggleButton fx:id="filterAll" text="All" styleClass="chip" toggleGroup="$filterGroup" selected="true"/>
            <ToggleButton fx:id="filterInStock" text="In Stock" styleClass="chip" toggleGroup="$filterGroup"/>
            <ToggleButton fx:id="filterLowStock" text="Low Stock" styleClass="chip" toggleGroup="$filterGroup"/>
            <ToggleButton fx:id="filterOutOfStock" text="Out of Stock" styleClass="chip" toggleGroup="$filterGroup"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Label fx:id="resultLabel" styleClass="result-label"/>
            <Button text="Refresh" styleClass="btn,btn-secondary" onAction="#handleRefresh">
                <graphic><Icon name="refresh" size="16"/></graphic>
            </Button>
        </HBox>

        <TableView fx:id="productTable" VBox.vgrow="ALWAYS">
            <columns>
                <TableColumn fx:id="idColumn" text="PRODUCT ID" prefWidth="130"/>
                <TableColumn fx:id="nameColumn" text="PRODUCT NAME" prefWidth="380"/>
                <TableColumn fx:id="quantityColumn" text="QUANTITY" prefWidth="140"/>
                <TableColumn fx:id="statusColumn" text="STOCK STATUS" prefWidth="190"/>
                <TableColumn fx:id="actionsColumn" text="ACTIONS" prefWidth="110"/>
            </columns>
        </TableView>
    </VBox>
</VBox>
